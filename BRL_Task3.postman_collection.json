{
  "info": {
    "name": "BRL Task 3 — Chat Application API",
    "description": "REST API for the real-time chat application.\n\n**How to use:** run **Login - success** first — it saves the returned JWT into the `authToken` collection variable, which every protected request reads.\n\n**Base URL:** `{{baseUrl}}` (local default `http://localhost:5000`)\n\n**Auth:** protected routes require header `Authorization: Bearer <token>`.\n\n**Real-time (WebSockets):** messages are delivered over Socket.IO on the same host/port. Handshake must include `auth: { token: <JWT> }`; the server rejects invalid tokens. Events: `message:send` (client → server, ack-confirmed), `message:new`, `conversation:new`, `presence:update`, `presence:list`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "authToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "conversationId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns token + user without password', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.success).to.be.true;",
                  "  pm.expect(b).to.have.property('token');",
                  "  pm.expect(b.user).to.not.have.property('password');",
                  "  pm.collectionVariables.set('userId', b.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "201 → `{ success, token, user }`. 400 → missing/invalid fields. 409 → duplicate email. Passwords are hashed with bcrypt (cost 10); the plain password is never stored or returned."
          }
        },
        {
          "name": "Register - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Again\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Expected: 409 Conflict"
          }
        },
        {
          "name": "Register - validation errors (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Expected: 400 with a message describing the first failing rule (name ≥ 2 chars, valid email, password ≥ 6 chars)"
          }
        },
        {
          "name": "Login - success (saves authToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Saves authToken + userId', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.success).to.be.true;",
                  "  pm.collectionVariables.set('authToken', b.token);",
                  "  pm.collectionVariables.set('userId', b.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "200 → `{ success, token, user }`. 401 → invalid email **or** password (same message for both, so account existence can't be enumerated). 429 → too many attempts (rate limited: 50 / 15 min)."
          }
        },
        {
          "name": "Login - invalid credentials (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get current user (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No password field', () => pm.expect(pm.response.json().user).to.not.have.property('password'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Header: `Authorization: Bearer {{authToken}}`. 401 if the token is missing/invalid/expired."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "JWTs are stateless — the server keeps no session. Logout = client deletes its token. Documented for completeness."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get users (auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No passwords in list', () => {",
                  "  pm.response.json().users.forEach(u => pm.expect(u).to.not.have.property('password'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "200 → `{ success, users: [{ _id, name, email, createdAt }] }` — everyone except the requester (sorted by name, max 100). 401 without a valid token."
          }
        },
        {
          "name": "Get users - no token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Expected: 401 `{ success: false, message: 'No token provided' }`"
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Create conversation (find-or-create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 201', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "pm.test('Saves conversationId', () => {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('conversationId', b.conversation._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"<a userId from GET /users>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/conversations", "host": ["{{baseUrl}}"], "path": ["conversations"] },
            "description": "Idempotent: creates the 1:1 conversation on first call (201) and returns the existing one on later calls (200) — enforced by a unique `pairKey` in MongoDB. The other participant receives `conversation:new` over WebSocket. 400 → missing/invalid receiverId or self-chat. 401 → no/invalid token."
          }
        },
        {
          "name": "Create conversation - self chat (400)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"receiverId\": \"{{userId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/conversations", "host": ["{{baseUrl}}"], "path": ["conversations"] },
            "description": "Expected: 400 — cannot start a conversation with yourself"
          }
        },
        {
          "name": "Get conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has conversations array', () => pm.expect(pm.response.json()).to.have.property('conversations'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": { "raw": "{{baseUrl}}/conversations", "host": ["{{baseUrl}}"], "path": ["conversations"] },
            "description": "200 → all conversations the requester belongs to (participants + lastMessage populated), newest activity first."
          }
        },
        {
          "name": "Get messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Messages oldest-first with sender populated', () => {",
                  "  const msgs = pm.response.json().messages;",
                  "  pm.expect(msgs).to.be.an('array');",
                  "  if (msgs.length) pm.expect(msgs[0].sender).to.have.property('name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}", "messages"],
              "query": [{ "key": "limit", "value": "50", "description": "1–200, default 50" }, { "key": "before", "value": "", "description": "ISO date — for paging older history" }]
            },
            "description": "200 → `{ success, messages }` oldest-first, `sender` populated with name/email. 400 → invalid conversation id. 401 → no token. 403 → requester is not a participant of this conversation. 404 → not found."
          }
        },
        {
          "name": "Get messages - not a participant (403)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": { "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages", "host": ["{{baseUrl}}"], "path": ["conversations", "{{conversationId}}", "messages"] },
            "description": "Login as a user who is NOT in this conversation and run: expected 403. Knowing an id is not enough to read someone else's chat."
          }
        },
        {
          "name": "Get single conversation",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": { "raw": "{{baseUrl}}/conversations/{{conversationId}}", "host": ["{{baseUrl}}"], "path": ["conversations", "{{conversationId}}"] },
            "description": "200 → the conversation with participants populated. 403 for non-participants, 404 if missing, 400 for a malformed id."
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "200 → `{ success: true, status: 'ok' }` — used by Render / uptime monitors. No auth."
          }
        }
      ]
    }
  ]
}
