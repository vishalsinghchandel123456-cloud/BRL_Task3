# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# MongoDB connection string (local or Atlas)
DATABASE_URL=mongodb://127.0.0.1:27017/brlChatDB

# Long random string used to sign JWTs (e.g. `openssl rand -hex 64`)
JWT_SECRET=change_me_to_a_long_random_string

# Port the API + WebSocket server listens on (Render sets this automatically)
PORT=5000

# Allowed frontend origin(s), comma-separated.
# Local Vite dev server in development, your Vercel URL in production.
CLIENT_URL=http://localhost:5173
